.decl DivExp(result:symbol, left_var:symbol, right_var:symbol)
.input DivExp
.decl IntVar(var:symbol, int_id:symbol)
.input IntVar
.decl IsMaybeZero(int_id:symbol)
.input IsMaybeZero

.decl ArithmeticError(result:symbol)
.output ArithmeticError

ArithmeticError(r) :- DivExp(r, v1, v2), IntVar(v2, i2), IsMaybeZero(i2).