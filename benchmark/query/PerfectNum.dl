.decl Gen(x:number)
.decl Lim(x:number)
.input Lim

.decl Perfect(x:number)
.output Perfect

.decl EFactor(x:number, fc:number)

// recursion seeds: part of the program, not of the instance
Gen(1).

Gen(x+1) :- Gen(x), !Lim(x).
EFactor(x, fc) :- Gen(fc), Gen(x), x % fc = 0, x!=fc.

Perfect(x) :- Gen(x), x = sum inv :EFactor(x, inv).
