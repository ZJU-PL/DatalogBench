.decl PointsInitial(var:symbol, heap:symbol)
.input PointsInitial
.decl Store(base_var:symbol, field:symbol, src_var:symbol)
.input Store
.decl Load(base_var:symbol, field:symbol, dst_var:symbol)
.input Load
.decl Invocation(caller1:symbol, caller2:symbol, heap:symbol, callee1:symbol, callee2:symbol, target:symbol)
.input Invocation
.decl Assign(callsite1:symbol, callsite2:symbol, var1:symbol, callsite3:symbol, callsite4:symbol, var2:symbol)
.input Assign

.decl Heappointsto(heap1:symbol, field:symbol, heap2:symbol)
.output Heappointsto
.decl Pointsto(callsite1:symbol, callsite2:symbol, var:symbol, heap:symbol)

Pointsto(c1, c2, v, h) :- PointsInitial(v, h), Invocation(c1, c2, h, callee, callee2, tgt).
Pointsto(c1, c2, v1, h) :- Assign(c1, c2, v1, c3, c4, v3), Pointsto(c3, c4, v3, h).
Pointsto(c1, c2, v2, h2) :- Load(v1, f, v2), Pointsto(c1, c2, v1, h1), Heappointsto(h1, f, h2).
Heappointsto(h1, f, h2) :- Store(v1, f, v2), Pointsto(c1, c2, v1, h1), Pointsto(c1, c2, v2, h2).