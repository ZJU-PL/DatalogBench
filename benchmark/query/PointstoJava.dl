.decl DirectFieldIndexSignature(class:symbol, index:symbol, field:symbol)
.input DirectFieldIndexSignature
.decl DirectSuperclass(subclass:symbol, superclass:symbol)
.input DirectSuperclass
.decl DirectSuperinterface(type:symbol, superinterface:symbol)
.input DirectSuperinterface
.decl HeapAllocationType(heap_allocation:symbol, allocation_type:symbol)
.input HeapAllocationType
.decl ThisVar(method:symbol, this_variable:symbol)
.input ThisVar
.decl ReturnVar(return_variable:symbol, method:symbol)
.input ReturnVar
.decl SpecialMethodInvocationSignature(callsite:symbol, called_method:symbol)
.input SpecialMethodInvocationSignature
.decl SpecialMethodInvocationBase(callsite:symbol, instance_variable:symbol)
.input SpecialMethodInvocationBase
.decl StaticMethodInvocationSignature(callsite:symbol, called_method:symbol)
.input StaticMethodInvocationSignature
.decl VirtualMethodInvocationSignature(callsite:symbol, called_method:symbol)
.input VirtualMethodInvocationSignature
.decl VirtualMethodInvocationBase(callsite:symbol, instance_variable:symbol)
.input VirtualMethodInvocationBase
.decl VarType(variable:symbol, type:symbol)
.input VarType
.decl FormalParam(index:symbol, containing_method:symbol, variable:symbol)
.input FormalParam
.decl ActualParam(index:symbol, callsite:symbol, actual_variable:symbol)
.input ActualParam
.decl AssignReturnValue(callsite:symbol, variable_assigned_to:symbol)
.input AssignReturnValue
.decl AssignCast(cast_type:symbol, variable_cast:symbol, variable_assigned_tp:symbol, containing_method:symbol)
.input AssignCast
.decl AssignLocal(variable_assigned:symbol, variable_assigned_to:symbol, containing_method:symbol)
.input AssignLocal
.decl AssignHeapAllocation(heap_allocation:symbol, variable_assigned_to:symbol, containing_method:symbol)
.input AssignHeapAllocation
.decl LoadInstanceFieldIndex(instance_variable:symbol, field:symbol, variable_assigned_to:symbol, containing_method:symbol)
.input LoadInstanceFieldIndex
.decl StoreInstanceFieldIndex(stored_variable:symbol, instance_variable:symbol, field:symbol, containing_method:symbol)
.input StoreInstanceFieldIndex

.decl VarPointsTo(variable:symbol, heap_allocation:symbol)
.output VarPointsTo

.decl InstanceVar(instance_variable:symbol)
.decl Superclass(subclass:symbol, superclass:symbol)
.decl Supertype(subtype:symbol, supertype:symbol)
.decl Invocation(callsite:symbol, called_method:symbol)
.decl InvocationBase(callsite:symbol, instance_variable:symbol)
.decl InstanceVarType(variable:symbol, type:symbol)
.decl InstanceTypes(type:symbol)
.decl IsInstanceTypeCompatible(subclass:symbol, superclass:symbol)
.decl InstanceTypeComparable(subclass:symbol, superclass:symbol)
.decl Assign(var_assigned:symbol, var_assigned_to:symbol)
.decl InstanceVarPointsTo(variable:symbol, heap_allocation:symbol)
.decl LoadInstanceVarPointsTo(variable:symbol, heap_allocation:symbol)
.decl StoreInstanceVarPointsTo(variable:symbol, heap_allocation:symbol)
.decl Alias(v1:symbol, v2:symbol)

InstanceVar(var) :- LoadInstanceFieldIndex(var, _, _, _).
InstanceVar(var) :- StoreInstanceFieldIndex(_, var, _, _).
Superclass(sub, super) :- DirectSuperclass(sub, super).
Superclass(sub, super) :- Superclass(sub, x), DirectSuperclass(x, super).
Supertype(sub, super) :- Superclass(sub, super).
Supertype(type, interface) :- DirectSuperinterface(type, interface).
Invocation(callsite, calledMethod) :- SpecialMethodInvocationSignature(callsite, calledMethod).
Invocation(callsite, calledMethod) :- StaticMethodInvocationSignature(callsite, calledMethod).
Invocation(callsite, calledMethod) :- VirtualMethodInvocationSignature(callsite, calledMethod).
InvocationBase(callsite, var) :- VirtualMethodInvocationBase(callsite, var).
InvocationBase(callsite, var) :- SpecialMethodInvocationBase(callsite, var).
InstanceVarType(var, type) :- VarType(var, type), InstanceVar(var).
InstanceTypes(x) :- InstanceVarType(_, x).
IsInstanceTypeCompatible(sub, super) :- Supertype(sub, super).
IsInstanceTypeCompatible(t, t) :- InstanceTypes(t).
InstanceTypeComparable(type1, type2) :- IsInstanceTypeCompatible(type1, type2).
InstanceTypeComparable(type1, type2) :- IsInstanceTypeCompatible(type2, type1).
Assign(localVarAssigned, localVarAssignedTo) :- AssignLocal(localVarAssigned, localVarAssignedTo, _).
Assign(actualParam, formalParam) :- Invocation(callsite, method), FormalParam(index, method, formalParam), ActualParam(index, callsite, actualParam).
Assign(returnVar, localVar) :- ReturnVar(returnVar, method), Invocation(callsite, method), AssignReturnValue(callsite, localVar).
Assign(base, this) :- InvocationBase(callsite, base), Invocation(callsite, method), ThisVar(method, this).
VarPointsTo(var, heap) :- AssignHeapAllocation(heap, var, _).
VarPointsTo(var1, heap) :- Assign(var2, var1), VarPointsTo(var2, heap).
VarPointsTo(var1, heap) :- AssignCast(type, var2, var1, _), VarPointsTo(var2, heap), HeapAllocationType(heap, type).
VarPointsTo(var1, heap) :- AssignCast(varType, var2, var1, _), VarPointsTo(var2, heap), HeapAllocationType(heap, heapType), Supertype(heapType, varType).
InstanceVarPointsTo(var1, var2) :- InstanceVar(var1), VarPointsTo(var1, var2).
LoadInstanceVarPointsTo(var, heap) :- InstanceVarPointsTo(var, heap), LoadInstanceFieldIndex(var, _, _, _).
StoreInstanceVarPointsTo(var, heap) :- InstanceVarPointsTo(var, heap), StoreInstanceFieldIndex(_, var, _, _).
Alias(v1, v2) :- LoadInstanceVarPointsTo(v1, h), StoreInstanceVarPointsTo(v2, h), InstanceVarType(v1, t1), InstanceVarType(v2, t2), InstanceTypeComparable(t1, t2).
Assign(storedVar, varAssignedTo) :- Alias(iLoadVar, iStoreVar), StoreInstanceFieldIndex(storedVar, iStoreVar, field, _), LoadInstanceFieldIndex(iLoadVar, field, varAssignedTo, _).
