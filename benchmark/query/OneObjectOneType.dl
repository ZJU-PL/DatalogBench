.decl PointsInitial(var:symbol, heap:symbol)
.input PointsInitial
.decl Store(base_var:symbol, field:symbol, src_var:symbol)
.input Store
.decl Load(base_var:symbol, field:symbol, dst_var:symbol)
.input Load
.decl Invocation(caller_heap:symbol, target_method:symbol)
.input Invocation
.decl Assign(callsite1:symbol, callsite2:symbol, var1:symbol, callsite3:symbol, callsite4:symbol, var2:symbol)
.input Assign
.decl ReceiverActual(method:symbol, var:symbol)
.input ReceiverActual
.decl EnclosingType(var:symbol, type:symbol)
.input EnclosingType

.decl Heappointsto(heap1:symbol, field:symbol, heap2:symbol)
.output Heappointsto
.decl Pointsto(callsite1:symbol, callsite2:symbol, var:symbol, heap:symbol)
.decl PointstoObjcont(var1:symbol, var2:symbol, heap:symbol)

PointstoObjcont(v2, v, h) :- PointsInitial(v, h), Invocation(h, tgt), ReceiverActual(tgt, v2).
Pointsto(t, v2, v, h) :- PointstoObjcont(v2, v, h), EnclosingType(v, t).
Pointsto(c2, c1, v1, h) :- Assign(c2, c1, v1, c3, c4, v3), Pointsto(c3, c4, v3, h).
Pointsto(c2, c, v2, h2) :- Load(v1, f, v2), Pointsto(c2, c, v1, h1), Heappointsto(h1, f, h2).
Heappointsto(h1, f, h2) :- Store(v1, f, v2), Pointsto(c1, c2, v1, h1), Pointsto(c1, c2, v2, h2).