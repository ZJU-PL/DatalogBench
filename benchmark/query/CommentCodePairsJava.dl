.decl JavaFile(id:number, path:symbol)
.input JavaFile
.decl CallableInfo(id:number, signature:symbol, body:symbol, file_id:number, start_line:number)
.input CallableInfo
.decl CommentInfo(id:number, text:symbol, file_id:number, start_line:number, end_line:number)
.input CommentInfo
.decl JavadocInfo(id:number, text:symbol, file_id:number, start_line:number, end_line:number, owner_id:number)
.input JavadocInfo
.decl AnnotationInfo(file_id:number, name:symbol, arg_value:symbol)
.input AnnotationInfo
.decl KeywordFilter(k:symbol)
.input KeywordFilter
.decl FolderFilter(n:symbol)
.input FolderFilter

.decl CmtCodePair(signature:symbol, method_text:symbol, comment_text:symbol)
.output CmtCodePair

.decl IsAutoGeneratedFile(file_id:number)
.decl CallableHasComment(cid:number, text:symbol)

IsAutoGeneratedFile(file_id) :- JavaFile(file_id, path), FolderFilter(pattern), contains(pattern, path).
IsAutoGeneratedFile(file_id) :- CommentInfo(_, text, file_id, _, _), KeywordFilter(key), contains(key, text).
IsAutoGeneratedFile(file_id) :- JavadocInfo(_, text, file_id, _, _, _), KeywordFilter(key), contains(key, text).
IsAutoGeneratedFile(file_id) :- AnnotationInfo(file_id, _, _).
CallableHasComment(cid, text) :- JavadocInfo(_, text, _, _, _, cid), cid != 0.
CallableHasComment(cid, text) :- CallableInfo(cid, _, _, file_id, c_start), JavadocInfo(_, text, file_id, _, j_end, 0), c_start = j_end + 1.
CallableHasComment(cid, text) :- CallableInfo(cid, _, _, file_id, c_start), CommentInfo(_, text, file_id, _, c_end), c_start = c_end + 1.

CmtCodePair(signature, method_text, comment_text) :- CallableInfo(cid, signature, method_text, file_id, _), !IsAutoGeneratedFile(file_id), CallableHasComment(cid, comment_text).