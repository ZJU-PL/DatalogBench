.decl Food(name:symbol, carbs:number, fat:number, protein:number, per:number, measure:symbol)
.input Food
.decl Recipe(index:number, name:symbol, amount:number, measure:symbol)
.input Recipe

.decl MaxIndex(result:number)
.output MaxIndex
.decl Totals(name:symbol, amount:number, carbs:number, fat:number, protein:number, cal:number)
.output Totals
.decl Calories(result:number)
.output Calories

MaxIndex(a) :-  a = max a : Recipe(a, _, _, _) .
Totals(name, amount, amount*a/per, amount*b/per, amount*c/per, ((4*amount*a/per)+(9*amount*b/per)+(4*amount*c/per))) :- Recipe(_, name, amount, _), Food(name, a, b, c, per, _).
Calories(result) :- result = sum a : Totals(_, _, _, _, _, a).